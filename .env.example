NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local Postgres (Supabase CLI custom ports, see docs/DECISIONS.md); needed by `pnpm seed`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
CRON_SECRET=change-me
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ejarikw.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Self-serve office signup (set to `false` to close registration).
NEXT_PUBLIC_ALLOW_SIGNUP=true
# Show the one-tap demo accounts on the login page (set to `0` in production).
NEXT_PUBLIC_DEMO_ACCOUNTS=1
# Legal pages contact address.
NEXT_PUBLIC_SUPPORT_EMAIL=support@ejarikw.com
# Production: NEXT_PUBLIC_APP_URL=https://ejarikw.com
