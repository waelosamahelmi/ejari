{
  "name": "ijari",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/types.ts",
    "seed": "tsx scripts/seed.ts",
    "test:rls": "SUPABASE_TEST=1 vitest run tests/rls",
    "brand:build": "tsx scripts/brand/build-brand.ts",
    "brand:assets": "tsx scripts/brand/build-brand.ts && tsx scripts/generate-brand-assets.ts",
    "vapid": "tsx scripts/generate-vapid.ts",
    "screenshots": "tsx scripts/capture-screenshots.ts"
  },
